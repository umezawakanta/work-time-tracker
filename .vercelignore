# Documentation (limit scope; keep docs served from public/)
docs/
!public/docs/**
!README.md

# Server-only code not needed for Vercel build
src/server/**

# Test utilities (already excluded by patterns, add explicit dirs)
src/test/**
src/test-utils/**
**/__tests__/**

# Storybook and stories
.storybook/
**/*.stories.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
