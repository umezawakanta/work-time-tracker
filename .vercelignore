# Node modules
node_modules/

# Build artifacts
dist/
build/
.next/

# Development files
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
cypress/
coverage/
.nyc_output/

# Documentation (limit scope; keep docs served from public/)
docs/
!public/docs/**
!README.md

# Server-only code not needed for Vercel build
src/server/**

# Test utilities (already excluded by patterns, add explicit dirs)
src/test/**
src/test-utils/**
**/__tests__/**

# Storybook and stories
.storybook/
**/*.stories.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Cache
.cache/
.parcel-cache/
.eslintcache

# Backup files
*.bak
*.backup
*.old

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Uploads (if not needed for production)
uploads/

## Do not ignore scripts so Vercel ignoreCommand can run
# scripts/

# Lighthouse reports
lighthouse/
lighthouserc.json 

