{
    "name": "work-time-tracker",
    "private": true,
    "version": "1.2.0",
    "type": "module",
    "packageManager": "pnpm@10.15.1",
    "engines": {
        "node": ">=20.0.0 <21.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "vercel-build": "vite build --config vite.config.ts --minify false --logLevel warn",
        "vercel-build-ci": "cross-env NODE_OPTIONS=--max_old_space_size=1536 VITE_ENABLE_REACT_GUARD=false VITE_DISABLE_CSS_MINIFY=true VITE_ENABLE_PWA=false VITE_CJS_IGNORE_WARNING=true pnpm run vercel-build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 200",
        "lint:ci": "eslint . --ext ts,tsx --max-warnings 0 --ignore-pattern 'api/**'",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "preview": "vite preview",
        "preview:start": "vite preview --port 4173",
        "dev": "pnpm run start",
        "dev:vercel": "vercel dev",
        "pre-commit": "lint-staged",
        "type-check": "tsc --noEmit --skipLibCheck",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
        "quality:check": "pnpm run lint && pnpm run type-check",
        "quality:full": "pnpm run quality:check && pnpm run format:check",
        "quality:fix": "pnpm run lint:fix && pnpm run format",
        "ci:quality": "pnpm run quality:full",
        "postinstall": "echo skipping dedupe on Vercel"
    },
