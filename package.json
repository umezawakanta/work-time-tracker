        "postcss": "^8.5.4",
        "prettier": "^3.2.5",
        "tailwindcss": "4.1.8",
        "tailwindcss-animate": "^1.0.7",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write",
            "bash -c 'if [ \"$ENABLE_AI_REVIEW\" = \"true\" ]; then node scripts/ai-review.js; fi'"
        ],
        "*.{js,jsx,json,css,md}": [
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "npm run type-check && npm run test:unit"
        }
    }
}