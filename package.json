{
    "name": "work-time-tracker",
    "private": true,
    "version": "0.0.1",
    "packageManager": "pnpm@10.4.1",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "start": "vite",
        "build": "pnpm run build:version && vite build",
        "vercel-build": "pnpm run build:version && vite build --config vite.config.ts --minify false --logLevel warn",
        "build:version": "node scripts/generate-version.mjs",
        "build:dev-status": "node scripts/dev-status-scan.mjs",
        "vercel-build-ci": "cross-env NODE_OPTIONS=--max_old_space_size=1536 VITE_ENABLE_REACT_GUARD=false VITE_DISABLE_CSS_MINIFY=true VITE_ENABLE_PWA=false VITE_CJS_IGNORE_WARNING=true pnpm run vercel-build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 200",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "preview": "vite preview",
        "server": "tsx src/server/server-simple.ts",
        "dev": "concurrently \"pnpm run start\" \"pnpm run server\"",
        "dev:vercel": "vercel dev",
        "setup:anthropic": "node scripts/test-anthropic-api.js && echo 'Run \"pnpm dev\" to start the development server'",
        "setup:anthropic:unix": "bash scripts/setup-anthropic.sh",
        "setup:anthropic:win": "scripts\\setup-anthropic.bat",
        "test": "jest",
        "test:anthropic": "node scripts/test-anthropic-api.js",
        "test:unit": "jest --coverage",
        "test:watch": "jest --watch",
        "test:watch-all": "jest --watchAll",
        "test:file": "jest --testPathPattern",
        "test:specific": "jest --testNamePattern",
        "test:integration": "jest --config jest.integration.config.js",
        "test:e2e": "vite preview --port 4173 & npx wait-on http://localhost:4173 && cypress run",
        "test:e2e:open": "vite preview --port 4173 & npx wait-on http://localhost:4173 && cypress open",
        "test:coverage": "jest --coverage --coverageReporters=text-lcov",
        "test:coverage:html": "jest --coverage --coverageReporters=html",
        "test:coverage:full": "jest --coverage --coverageReporters=html --coverageReporters=lcov --coverageReporters=text --coverageReporters=clover",
        "test:coverage:serve": "pnpm run test:coverage:full && npx http-server coverage/lcov-report -p 8080 -o",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "lighthouse:autorun": "lhci autorun",
        "lighthouse:manual": "lighthouse http://localhost:3002 --output html --output-path ./lighthouse-report.html",
        "lighthouse:ci": "lhci autorun --assert --upload.target=temporary-public-storage",
        "performance:monitor": "pnpm run lighthouse:autorun && pnpm run test:coverage",
        "performance:full": "pnpm run build && pnpm run preview & sleep 5 && pnpm run lighthouse:ci && kill %1",
        "build:analyze": "vite build --mode analyze",
        "build:production": "vite build --mode production",
        "build:optimized": "pnpm run build:production && pnpm run lighthouse:ci",
        "production:optimize": "pnpm run build:optimized && pnpm run performance:monitor",
        "pre-commit": "lint-staged",
        "type-check": "tsc --noEmit --skipLibCheck",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
        "analyze": "vite build --mode analyze && npx vite-bundle-analyzer dist",
        "quality:check": "pnpm run lint && pnpm run type-check && pnpm run test:ci",
        "quality:full": "pnpm run quality:check && pnpm run test:coverage && pnpm run format:check",
        "quality:fix": "pnpm run lint:fix && pnpm run format && pnpm run test:coverage",
        "ci:quality": "pnpm run quality:full && pnpm run lighthouse:ci",
        "test:auth": "jest --config jest.auth.config.js",
        "test:auth:watch": "jest --config jest.auth.config.js --watch",
        "test:auth:coverage": "jest --config jest.auth.config.js --coverage",
        "test:auth:ci": "jest --config jest.auth.config.js --ci --coverage --watchAll=false",
        "test:auth:debug": "jest --config jest.auth.config.js --runInBand --detectOpenHandles",
        "test:auth:verbose": "jest --config jest.auth.config.js --verbose",
        "test:auth:clean": "jest --config jest.auth.config.js --clearCache",
        "postinstall": "node scripts/dev-status-scan.mjs || echo skip-dev-status && echo skipping dedupe on Vercel"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@firebase/util",
            "protobufjs",
            "@swc/core",
            "sypress",
            "esbuild"
