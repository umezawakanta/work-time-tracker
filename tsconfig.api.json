{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true
    },
    "include": [
        "api/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}