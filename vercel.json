{
  "version": 2,
  "buildCommand": "NODE_OPTIONS=--max_old_space_size=1536 VITE_ENABLE_REACT_GUARD=false VITE_DISABLE_CSS_MINIFY=true VITE_ENABLE_PWA=false pnpm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile --prefer-offline",
  "devCommand": "pnpm run dev",
  "ignoreCommand": "node scripts/vercel-ignore.js",
  "functions": {},
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}