{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.0.7"
    },
    "api/**/*.js": {
      "runtime": "@vercel/node@3.0.7"
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./"
}