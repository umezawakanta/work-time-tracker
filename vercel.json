{
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@10.4.1 --activate || npm i -g pnpm@10.4.1 && pnpm install --no-frozen-lockfile",
  "devCommand": "pnpm run dev",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/{services,server,types,utils}/**",
      "excludeFiles": "{src/components/**,src/pages/**,coverage/**,**/__tests__/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}