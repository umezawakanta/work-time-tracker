{
    "version": 2,
    "buildCommand": "pnpm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "builds": [
      {
        "src": "src/server/server.ts",
        "use": "@vercel/node"
      },
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist",
          "buildCommand": "pnpm run build"
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "src/server/server.ts"
      },
      {
        "src": "/(.*)",
        "dest": "/dist/$1"
      },
      {
        "src": "/assets/(.*)",
        "dest": "/dist/assets/$1"
      },
      {
        "handle": "filesystem"
      },
      {
        "src": "/.*",
        "dest": "/index.html"
      }
    ]
  }