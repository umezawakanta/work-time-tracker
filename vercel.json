{
  "version": 2,
  "buildCommand": "pnpm run vercel-build-ci",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm config set store-dir .pnpm-store && pnpm install --prefer-offline --frozen-lockfile=false",
  "devCommand": "pnpm run dev",
  "ignoreCommand": "node scripts/vercel-ignore.js",
  "functions": {
    "api/auth/register.ts": {
      "runtime": "nodejs22.x",
      "includeFiles": "src/server/**"
    },
    "api/auth/login.ts": {
      "runtime": "nodejs22.x",
      "includeFiles": "src/server/**"
    },
    "api/db/status.ts": {
      "runtime": "nodejs22.x",
      "includeFiles": "src/server/**"
    }
  },
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/changelog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dev-status.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/analytics/aggregate-daily",
      "schedule": "0 3 * * *"
    }
  ]
}