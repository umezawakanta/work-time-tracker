{
  "version": 2,
  "buildCommand": "NODE_OPTIONS=--max_old_space_size=1536 VITE_ENABLE_REACT_GUARD=false pnpm run vercel-build -- --force",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "corepack enable && corepack prepare pnpm@10.4.1 --activate || npm i -g pnpm@10.4.1 && pnpm install --no-frozen-lockfile --prefer-offline --prefer-frozen-lockfile=false",
  "devCommand": "pnpm run dev",
  "ignoreCommand": "node scripts/vercel-ignore.js",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.3.0",
      "includeFiles": "{src/server/config/**,src/server/models/**,src/middleware/**,lib/**}",
      "excludeFiles": "{src/components/**,src/pages/**,coverage/**,**/__tests__/**,cypress/**,docs/**}"
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}