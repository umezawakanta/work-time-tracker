{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173"
      ],
      "numberOfRuns": 1,
      "headful": false,
      "settings": {
        "onlyAudits": [
          "first-contentful-paint",
          "largest-contentful-paint",
          "first-input-delay",
          "cumulative-layout-shift",
          "speed-index",
          "interactive"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}